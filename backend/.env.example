# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me

# CORS — comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_email_assistant
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_MAX=600

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend / session
FRONTEND_BASE_URL=http://localhost:5173
SESSION_TTL_SECONDS=604800

# Token encryption
TOKEN_ENCRYPTION_KEY=change-me

# LLM Provider
ANTHROPIC_API_KEY=
LLM_CLASSIFICATION_MODEL=claude-haiku-4-5-20251001
LLM_DRAFTING_MODEL=claude-sonnet-5
LLM_CRITIQUE_MODEL=claude-sonnet-5

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
