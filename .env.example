# ==============================================================================
# Root environment file — read automatically by Docker Compose (from the
# same directory as docker-compose.yml) for ${VARIABLE} substitution inside
# the compose files themselves. This is DISTINCT from backend/.env and
# frontend/.env, which are loaded into the containers at runtime via
# `env_file:` and hold application-level configuration.
#
# Copy this file to `.env` before running `docker compose up`.
# ==============================================================================

# Used as a prefix for container names and the Compose project name,
# so `docker ps` output is unambiguous if other projects are running
# on the same machine.
COMPOSE_PROJECT_NAME=ai-email-assistant

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_email_assistant
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API ---
API_PORT=8000

# --- Frontend (dev server) ---
FRONTEND_DEV_PORT=5173

# --- Reverse proxy ---
NGINX_PORT=80

# --- Build target ---
# Switches which Dockerfile stage docker-compose builds.
# Set to "development" for local work, "production" for deploys.
BUILD_TARGET=development
